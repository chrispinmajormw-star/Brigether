# Postgres
DATABASE_URL=postgresql://brigether:brigether@localhost:5432/brigether?schema=public
# Redis
REDIS_URL=redis://localhost:6379
# API
API_PORT=4000
JWT_SECRET=change-me-in-prod-please
WEB_ORIGIN=http://localhost:3000
# Google OAuth (optional in dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LiveKit (Phase 2; required for lobby token issuance)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Client‑side env vars (Next.js will expose NEXT_PUBLIC_*)
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
NEXT_PUBLIC_API_URL=http://localhost:4000
